{
  "name": "@havenhub/api",
  "version": "0.0.0",
  "private": true,
  "description": "HavenHub REST API (NestJS). Consumed by the web app and the future Flutter app.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@havenhub/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "multer": "2.4.0",
    "nodemailer": "^10.0.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.0",
    "vitest": "^5.0.3"
  }
}
