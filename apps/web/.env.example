# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are exposed to the browser —
# never put secrets here.

# Where the web server reaches the HavenHub API (server-side only, never sent
# to browsers). Browsers call this app's /api/* which is proxied here.
API_INTERNAL_URL=http://localhost:4000
# Canonical public URL of this site (used for metadata / SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox public access token (pk.…) for map tiles. REQUIRED IN PRODUCTION.
# When unset, maps fall back to OpenStreetMap tiles, which are fine for local
# development but not permitted for production traffic.
# NEXT_PUBLIC_MAPBOX_TOKEN=
