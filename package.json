{
  "name": "havenhub",
  "version": "0.0.0",
  "private": true,
  "description": "HavenHub \u2014 Nigerian property, rental, hospitality, events and experiences marketplace.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @havenhub/shared --filter @havenhub/api --filter @havenhub/web dev",
    "dev:web": "pnpm --filter @havenhub/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @havenhub/api dev",
    "build": "pnpm db:generate && pnpm -r build",
    "build:api": "pnpm db:generate && pnpm --filter \"@havenhub/api...\" build",
    "build:web": "pnpm --filter \"@havenhub/web...\" build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "start:api": "pnpm --filter @havenhub/api start",
    "start:web": "pnpm --filter @havenhub/web start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm db:generate && pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "pnpm build:packages && pnpm --filter @havenhub/api seed",
    "admin:create": "pnpm build:packages && pnpm --filter @havenhub/api admin:create --",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/node": "^24.0.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "~7.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
