# ─────────────────────────────────────────────────────────────
# HavenHub environment configuration
# Copy to `.env` (root) and fill in values. Never commit `.env`.
# The API, Prisma and scripts read the root `.env`; the web app reads
# apps/web/.env.local (see apps/web/.env.example).
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development

# API
API_PORT=4000
# Comma-separated browser origins allowed to call the API (the web app's origin)
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app — used for links in emails
WEB_APP_URL=http://localhost:3000
# Express "trust proxy": hop count (e.g. 1 behind one load balancer) or "loopback"
TRUST_PROXY=loopback

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://havenhub:havenhub@localhost:5432/havenhub?schema=public

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# ── Secrets (REQUIRED) — generate each with: openssl rand -base64 32 ──
# Encrypts NIN and bank account numbers at rest. Losing it makes them unreadable.
FIELD_ENCRYPTION_KEY=
# Signs CSRF tokens for cookie-authenticated web sessions.
AUTH_SECRET=

# ── Auth policy ──
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# When false, unverified users may sign in (sensitive actions still require verification)
REQUIRE_EMAIL_VERIFICATION=true
# Defaults to true when NODE_ENV=production. Only set false for local HTTP.
# COOKIE_SECURE=
# Optional cookie Domain (e.g. .havenhub.ng). Omit for host-only cookies.
# COOKIE_DOMAIN=
RATE_LIMIT_ENABLED=true

# ── Email (SMTP). Production needs these or admin-managed SMTP (Settings → Outgoing email); admin
# settings override them. In development without either, emails are printed to the API log. ──
MAIL_FROM="HavenHub <no-reply@havenhub.ng>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ── Tests (optional) ──
# Integration tests default to <DATABASE_URL database>_test and Redis DB 15.
# TEST_DATABASE_URL=
# TEST_REDIS_URL=

# ── Media storage ──
# `local` writes uploads to .devdata/uploads (development only; refused when NODE_ENV=production).
# `s3` works with any S3-compatible service (AWS S3, Cloudflare R2, Backblaze B2, MinIO…).
STORAGE_DRIVER=local
# Base URL clients load files from. Local default is the API's own /api/media route.
# For S3, use the bucket's public or CDN URL, e.g. https://media.havenhub.ng
STORAGE_PUBLIC_BASE_URL=/api/media
# STORAGE_LOCAL_DIR=
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_FORCE_PATH_STYLE=

# ── Bookings & payments ──
# `test` simulates payments for local development (no money moves; refused in
# production). `paystack` takes real payments and requires PAYSTACK_SECRET_KEY.
PAYMENT_PROVIDER=test
# Paystack secret key (sk_test_… / sk_live_…). Also verifies webhook signatures:
# point Paystack's webhook URL at https://<api-host>/api/v1/payments/webhooks/paystack
# PAYSTACK_SECRET_KEY=
# How long an unpaid booking holds its dates (minutes)
BOOKING_HOLD_MINUTES=30
# Expiry/completion sweep interval (seconds); 0 disables it
BOOKING_SWEEP_INTERVAL_SECONDS=60
# Lease (seconds) on each scheduled job's Redis lock, so only one API instance
# runs a job at a time; a crashed instance holds a job back for at most this long.
SCHEDULED_JOB_LOCK_TTL_SECONDS=120
# Subscription sweep interval (seconds): ends/starts plan terms and sends expiry
# reminders; 0 disables it. Plan limits never depend on it running.
SUBSCRIPTION_SWEEP_INTERVAL_SECONDS=300

# ── Messaging ──
# Chat sweep interval (seconds): sends unread-message email digests and removes
# attachments uploaded but never sent; 0 disables it.
CHAT_SWEEP_INTERVAL_SECONDS=60
# How long a message stays unread before the recipient gets one digest email.
CHAT_EMAIL_DELAY_SECONDS=600

# ── CMS (Phase 7) ──
# CMS sweep interval (seconds): sends due email campaigns and applies the CV
# retention setting; 0 disables it.
CMS_SWEEP_INTERVAL_SECONDS=60
# Campaign emails sent per sweep tick.
CAMPAIGN_BATCH_SIZE=50
# Shared secret (32+ characters) the API uses to ask the web app to refresh
# cached CMS pages. Server-side only — set the same value for both apps.
# Leave empty to disable (pages then refresh within about a minute).
REVALIDATE_SECRET=
# Where the API reaches the web app for revalidation (defaults to WEB_APP_URL).
# WEB_INTERNAL_URL=http://localhost:3000
