// HavenHub database schema.
//
// Models are added phase by phase. Phase 1: accounts, sessions, email tokens,
// RBAC, agent profiles/payout accounts and the audit log.
//
// Conventions:
//   - Primary keys: `String @id @default(uuid(7)) @db.Uuid` (time-ordered UUIDs)
//   - Money: `Int` / `BigInt` in kobo — never Float/Decimal naira
//   - Table names: snake_case plural via @@map; column names via @map
//   - Timestamps: createdAt / updatedAt on every mutable table (timestamptz)
//   - Sensitive values (NIN, bank account numbers) are stored only as
//     AES-256-GCM ciphertext plus a non-reversible last-4 for display.

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts ────────────────────────────────────────────────────────────────

enum AccountType {
  CUSTOMER
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

model User {
  id              String      @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed.
  email           String      @unique @db.VarChar(254)
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz(3)
  passwordHash    String      @map("password_hash")
  fullName        String      @map("full_name") @db.VarChar(120)
  /// E.164 format, e.g. +2348031234567
  phone           String?     @db.VarChar(20)
  /// Storage key of the profile photo; URLs are derived at read time.
  avatarKey       String?     @map("avatar_key") @db.VarChar(300)
  accountType     AccountType @map("account_type")
  status          UserStatus  @default(ACTIVE)
  statusReason    String?     @map("status_reason") @db.VarChar(500)
  lastLoginAt     DateTime?   @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                Session[]
  verificationTokens      VerificationToken[]
  roles                   UserRole[]                @relation("UserRoles")
  rolesAssigned           UserRole[]                @relation("UserRolesAssignedBy")
  agentProfile            AgentProfile?             @relation("AgentProfileUser")
  agentsReviewed          AgentProfile[]            @relation("AgentProfileReviewer")
  auditLogs               AuditLog[]
  propertiesReviewed      Property[]                @relation("PropertyReviewer")
  favorites               PropertyFavorite[]
  bookings                Booking[]                 @relation("BookingCustomer")
  pricingConfigs          PricingConfig[]
  refundsReviewed         Refund[]                  @relation("RefundReviewer")
  plansCreated            SubscriptionPlan[]        @relation("SubscriptionPlanCreator")
  conversations           ConversationParticipant[]
  messagesSent            Message[]                 @relation("MessageSender")
  messagesDeleted         Message[]                 @relation("MessageDeleter")
  conversationsClosed     Conversation[]            @relation("ConversationCloser")
  attachmentsUploaded     MessageAttachment[]
  experiencesReviewed     Experience[]              @relation("ExperienceReviewer")
  vacationZonesCreated    VacationZone[]
  cmsMediaUploaded        CmsMedia[]                @relation("CmsMediaUploader")
  pagesUpdated            Page[]                    @relation("PageUpdater")
  blogPostsAuthored       BlogPost[]                @relation("BlogPostAuthor")
  campaignsCreated        EmailCampaign[]           @relation("CampaignCreator")
  applicationsReviewed    JobApplication[]          @relation("ApplicationReviewer")
  siteSettingsUpdated     SiteSettings[]            @relation("SiteSettingsUpdater")
  smtpSettingsUpdated     SmtpSettings[]            @relation("SmtpSettingsUpdater")
  platformSettingsUpdated PlatformSettings[]        @relation("PlatformSettingsUpdater")
  notifications           Notification[]
  notificationBroadcasts  NotificationBroadcast[]   @relation("NotificationBroadcastSender")
  discountCodesCreated    DiscountCode[]            @relation("DiscountCodeCreator")
  discountRedemptions     DiscountRedemption[]
  popupsCreated           Popup[]                   @relation("PopupCreator")
  reviewsWritten          Review[]                  @relation("ReviewAuthor")
  reviewsHidden           Review[]                  @relation("ReviewModerator")
  badgesAwarded           BadgeAward[]              @relation("BadgeAwardAssigner")
  saleContactAcceptances  SaleContactAcceptance[]
  assistantQuestions      AssistantQuestion[]
  messageReactions        MessageReaction[]

  @@index([accountType, status])
  @@index([createdAt])
  @@map("users")
}

// ─── Authentication ──────────────────────────────────────────────────────────

enum ClientType {
  WEB
  TOKEN
}

/// One row per signed-in device. Both cookie (web) and bearer (mobile) clients
/// use the same session; only the transport of the tokens differs. Tokens are
/// `<sessionId>.<secret>`; only SHA-256 hashes of the secrets are stored.
model Session {
  id                       String     @id @default(uuid(7)) @db.Uuid
  userId                   String     @map("user_id") @db.Uuid
  clientType               ClientType @map("client_type")
  accessTokenHash          String     @map("access_token_hash") @db.Char(64)
  accessTokenExpiresAt     DateTime   @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenHash         String     @map("refresh_token_hash") @db.Char(64)
  /// Kept after rotation to detect refresh-token reuse (theft).
  previousRefreshTokenHash String?    @map("previous_refresh_token_hash") @db.Char(64)
  /// When the refresh token last rotated; concurrent refreshes within a short
  /// grace window are tolerated instead of being treated as token theft.
  refreshRotatedAt         DateTime?  @map("refresh_rotated_at") @db.Timestamptz(3)
  expiresAt                DateTime   @map("expires_at") @db.Timestamptz(3)
  userAgent                String?    @map("user_agent") @db.VarChar(512)
  ipAddress                String?    @map("ip_address") @db.VarChar(64)
  lastUsedAt               DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt                DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokedReason            String?    @map("revoked_reason") @db.VarChar(60)
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  /// Active users by session activity (analytics).
  @@index([lastUsedAt])
  @@map("sessions")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use tokens sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?             @map("used_at") @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ─── RBAC ────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable identifier, e.g. "super_admin", "finance_admin".
  key         String   @unique @db.VarChar(60)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// System roles are managed by the seed and cannot be deleted.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// `<resource>.<action>`, e.g. "users.block". Catalogue lives in @havenhub/shared.
  key         String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRolesAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── Agents ──────────────────────────────────────────────────────────────────

enum AgentVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  BLOCKED
}

enum Sex {
  MALE
  FEMALE
}

enum AgentServiceType {
  PROPERTY_OWNER
  LANDLORD
  REAL_ESTATE_AGENT
  HOTEL_OPERATOR
  EVENT_ORGANIZER
  TOUR_OPERATOR
  CLEANER
}

enum IdDocumentType {
  NIN_SLIP
  INTERNATIONAL_PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

model AgentProfile {
  id           String             @id @default(uuid(7)) @db.Uuid
  userId       String             @unique @map("user_id") @db.Uuid
  businessName String?            @map("business_name") @db.VarChar(160)
  bio          String?            @db.VarChar(1500)
  sex          Sex
  serviceTypes AgentServiceType[] @map("service_types")

  addressLine String? @map("address_line") @db.VarChar(240)
  city        String? @db.VarChar(100)
  lga         String? @db.VarChar(100)
  state       String? @db.VarChar(60)

  // Identity — never exposed publicly. Encrypted at rest (AES-256-GCM).
  ninCiphertext  String?         @map("nin_ciphertext")
  /// HMAC-SHA256 of the NIN for duplicate detection without decryption.
  ninFingerprint String?         @unique @map("nin_fingerprint") @db.Char(64)
  ninLast4       String?         @map("nin_last4") @db.Char(4)
  idDocumentType IdDocumentType? @map("id_document_type")

  verificationStatus      AgentVerificationStatus @default(PENDING) @map("verification_status")
  verificationNote        String?                 @map("verification_note") @db.VarChar(1000)
  verificationSubmittedAt DateTime?               @map("verification_submitted_at") @db.Timestamptz(3)
  verificationReviewedAt  DateTime?               @map("verification_reviewed_at") @db.Timestamptz(3)
  verificationReviewerId  String?                 @map("verification_reviewer_id") @db.Uuid
  verifiedAt              DateTime?               @map("verified_at") @db.Timestamptz(3)

  onboardingDismissedAt DateTime? @map("onboarding_dismissed_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User                  @relation("AgentProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  verificationReviewer User?                 @relation("AgentProfileReviewer", fields: [verificationReviewerId], references: [id], onDelete: SetNull)
  payoutAccount        PayoutAccount?
  properties           Property[]
  bookings             Booking[]
  earnings             AgentEarning[]
  subscriptions        AgentSubscription[]
  subscriptionPayments SubscriptionPayment[]
  discountCodesOwned   DiscountCode[]        @relation("DiscountCodeOwner")
  experiences          Experience[]

  @@index([verificationStatus, verificationSubmittedAt])
  @@map("agent_profiles")
}

/// Where an agent's earnings are paid. One per agent for now; Phase 3 adds
/// provider-side verification (e.g. Paystack account resolution).
model PayoutAccount {
  id                      String    @id @default(uuid(7)) @db.Uuid
  agentProfileId          String    @unique @map("agent_profile_id") @db.Uuid
  bankName                String    @map("bank_name") @db.VarChar(100)
  bankCode                String    @map("bank_code") @db.VarChar(10)
  accountName             String    @map("account_name") @db.VarChar(160)
  accountNumberCiphertext String    @map("account_number_ciphertext")
  accountNumberLast4      String    @map("account_number_last4") @db.Char(4)
  verifiedAt              DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

/// Append-only record of security-relevant and administrative actions.
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  /// e.g. "agent.verification.updated", "user.status.updated", "auth.login"
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(60)
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  /// Redacted snapshots — never contain secrets or sensitive identity data.
  before       Json?
  after        Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Property marketplace (Phase 2) ─────────────────────────────────────────

enum PropertyType {
  APARTMENT
  SELF_CONTAINED
  HOUSE
  DUPLEX
  BUNGALOW
  TERRACE
  PENTHOUSE
  LAND
  SHOP
  OFFICE
  WAREHOUSE
}

enum ListingType {
  RENT
  SALE
}

enum PricingPeriod {
  DAILY
  MONTHLY
  YEARLY
  SALE
}

/// One lifecycle including moderation (spec §47). Only PUBLISHED properties of
/// VERIFIED agents with ACTIVE accounts are publicly visible.
enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum CleaningOption {
  INCLUDED
  AVAILABLE_FOR_FEE
  CUSTOMER_MUST_CLEAN
  NOT_AVAILABLE
}

enum Currency {
  NGN
}

model Property {
  id             String         @id @default(uuid(7)) @db.Uuid
  agentProfileId String         @map("agent_profile_id") @db.Uuid
  /// Stable once published, so links and search rankings survive title edits.
  slug           String         @unique @db.VarChar(160)
  status         PropertyStatus @default(DRAFT)

  title         String         @db.VarChar(120)
  description   String?        @db.VarChar(5000)
  propertyType  PropertyType   @map("property_type")
  listingType   ListingType    @map("listing_type")
  pricingPeriod PricingPeriod? @map("pricing_period")

  // Location
  addressLine String?  @map("address_line") @db.VarChar(240)
  city        String?  @db.VarChar(100)
  lga         String?  @db.VarChar(100)
  state       String?  @db.VarChar(60)
  /// ISO 3166-1 alpha-2
  country     String   @default("NG") @db.Char(2)
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  // Details
  sizeSqm       Int?    @map("size_sqm")
  bedrooms      Int?    @db.SmallInt
  bathrooms     Int?    @db.SmallInt
  toilets       Int?    @db.SmallInt
  maxGuests     Int?    @map("max_guests") @db.SmallInt
  parkingSpaces Int?    @map("parking_spaces") @db.SmallInt
  furnished     Boolean @default(false)
  serviced      Boolean @default(false)

  // Pricing — integer kobo. BigInt because sale prices exceed 32-bit kobo.
  priceKobo       BigInt?         @map("price_kobo")
  currency        Currency        @default(NGN)
  cautionFeeKobo  BigInt?         @map("caution_fee_kobo")
  /// Display discount (1–90%). The discount engine arrives with payments.
  discountPercent Int?            @map("discount_percent") @db.SmallInt
  cleaningOption  CleaningOption? @map("cleaning_option")
  cleaningFeeKobo BigInt?         @map("cleaning_fee_kobo")
  availableFrom   DateTime?       @map("available_from") @db.Date

  // Moderation
  moderationNote    String?   @map("moderation_note") @db.VarChar(1000)
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(3)
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewerId        String?   @map("reviewer_id") @db.Uuid
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(3)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  /// Set while the agent features the listing; bounded by their plan's
  /// FEATURED_PROPERTY_COUNT entitlement.
  featuredAt        DateTime? @map("featured_at") @db.Timestamptz(3)
  /// Published reviews: sum of stars and count (average = sum / count).
  ratingSum         Int       @default(0) @map("rating_sum")
  reviewCount       Int       @default(0) @map("review_count")
  /// Bookings of this property that reached COMPLETED.
  completedBookings Int       @default(0) @map("completed_bookings")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agentProfile  AgentProfile            @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  reviews       Review[]
  badgeAwards   BadgeAward[]
  saleContacts  SaleContactAcceptance[]
  reviewer      User?                   @relation("PropertyReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  images        PropertyImage[]
  videos        PropertyVideo[]
  amenities     PropertyAmenity[]
  favorites     PropertyFavorite[]
  dailyViews    PropertyViewDaily[]
  bookings      Booking[]
  popups        Popup[]
  conversations Conversation[]

  @@index([agentProfileId, status])
  @@index([agentProfileId, featuredAt])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, listingType, pricingPeriod])
  @@index([status, propertyType])
  @@index([status, state, city])
  @@index([status, priceKobo])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@map("properties")
}

/// Stored once per upload as two renditions (large + thumbnail) in object storage.
model PropertyImage {
  id           String   @id @default(uuid(7)) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  storageKey   String   @map("storage_key") @db.VarChar(300)
  thumbnailKey String   @map("thumbnail_key") @db.VarChar(300)
  width        Int
  height       Int
  /// Size of the stored large rendition, for storage quotas.
  bytes        Int
  altText      String?  @map("alt_text") @db.VarChar(200)
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_images")
}

enum VideoProvider {
  YOUTUBE
  VIMEO
}

/// Videos are linked from YouTube/Vimeo in Phase 2 (no transcoding pipeline yet).
model PropertyVideo {
  id         String        @id @default(uuid(7)) @db.Uuid
  propertyId String        @map("property_id") @db.Uuid
  provider   VideoProvider
  externalId String        @map("external_id") @db.VarChar(40)
  title      String?       @db.VarChar(120)
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, provider, externalId])
  @@map("property_videos")
}

enum AmenityCategory {
  ESSENTIALS
  FEATURES
  SAFETY
  HOSPITALITY
}

/// Admin-managed catalogue; agents can only choose active amenities.
model Amenity {
  id        String          @id @default(uuid(7)) @db.Uuid
  slug      String          @unique @db.VarChar(60)
  name      String          @db.VarChar(60)
  category  AmenityCategory
  icon      String?         @db.VarChar(40)
  isActive  Boolean         @default(true) @map("is_active")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  properties  PropertyAmenity[]
  experiences ExperienceAmenity[]

  @@index([isActive, category, sortOrder])
  @@map("amenities")
}

model PropertyAmenity {
  propertyId String   @map("property_id") @db.Uuid
  amenityId  String   @map("amenity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([propertyId, amenityId])
  @@index([amenityId])
  @@map("property_amenities")
}

model PropertyFavorite {
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("property_favorites")
}

/// Daily view counters: cheap to write, easy to chart, no per-visitor data stored.
model PropertyViewDaily {
  propertyId String   @map("property_id") @db.Uuid
  day        DateTime @db.Date
  views      Int      @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, day])
  @@map("property_view_daily")
}

// ─── Bookings & payments (Phase 3) ──────────────────────────────────────────

/// Commission, VAT and fee rates (spec §29). Rows are immutable versions; the
/// newest one applies to new bookings and each booking keeps the one it used.
model PricingConfig {
  id                 String          @id @default(uuid(7)) @db.Uuid
  version            Int             @unique
  /// Rates in basis points (100 = 1%).
  serviceFeeBps      Int             @map("service_fee_bps")
  agentCommissionBps Int             @map("agent_commission_bps")
  vatBps             Int             @map("vat_bps")
  vatOnServiceFee    Boolean         @map("vat_on_service_fee")
  vatOnStay          Boolean         @map("vat_on_stay")
  /// Agency fee charged to the customer and paid in full to the agent (no
  /// HavenHub commission, no VAT added by HavenHub), on the rent after
  /// discounts, for the rental periods listed. 0 = no agency fee.
  agencyFeeBps       Int             @default(0) @map("agency_fee_bps")
  agencyFeePeriods   PricingPeriod[] @default([]) @map("agency_fee_periods")
  note               String?         @db.VarChar(500)
  createdById        String?         @map("created_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookings  Booking[]

  @@map("pricing_configs")
}

enum BookingStatus {
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum CancelledBy {
  CUSTOMER
  AGENT
  ADMIN
  SYSTEM
}

/// A reservation of a rental property for [startDate, endDate). Every amount
/// is calculated by the API at creation and frozen here: later price or fee
/// changes never alter an existing booking. Overlaps are prevented by the
/// `bookings_no_overlap` exclusion constraint (see migration), not only by code.
model Booking {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Human-friendly reference shown to customers, e.g. "HH-7KQ2M9XD".
  reference      String        @unique @db.VarChar(20)
  customerId     String        @map("customer_id") @db.Uuid
  propertyId     String        @map("property_id") @db.Uuid
  /// The property's owner when the booking was made.
  agentProfileId String        @map("agent_profile_id") @db.Uuid
  status         BookingStatus @default(AWAITING_PAYMENT)

  pricingPeriod    PricingPeriod @map("pricing_period")
  startDate        DateTime      @map("start_date") @db.Date
  /// Exclusive: the check-out day.
  endDate          DateTime      @map("end_date") @db.Date
  quantity         Int
  guests           Int?          @db.SmallInt
  cleaningSelected Boolean       @default(false) @map("cleaning_selected")

  // Frozen financial summary — integer kobo.
  currency            Currency @default(NGN)
  stayKobo            BigInt   @map("stay_kobo")
  cleaningKobo        BigInt   @map("cleaning_kobo")
  cautionKobo         BigInt   @map("caution_kobo")
  serviceFeeKobo      BigInt   @map("service_fee_kobo")
  vatKobo             BigInt   @map("vat_kobo")
  /// Paid to the agent in full (included in totalKobo and agentPayoutKobo).
  agencyFeeKobo       BigInt   @default(0) @map("agency_fee_kobo")
  totalKobo           BigInt   @map("total_kobo")
  agentCommissionKobo BigInt   @map("agent_commission_kobo")
  agentPayoutKobo     BigInt   @map("agent_payout_kobo")
  pricingConfigId     String   @map("pricing_config_id") @db.Uuid
  /// Title, address, unit price, discount and cleaning terms at booking time.
  propertySnapshot    Json     @map("property_snapshot")
  /// The agent's promo code used for this booking, and what it took off the stay.
  promoCode           String?  @map("promo_code") @db.VarChar(32)
  promoDiscountKobo   BigInt   @default(0) @map("promo_discount_kobo")

  /// Dates are held for an unpaid booking until this moment.
  holdExpiresAt      DateTime?    @map("hold_expires_at") @db.Timestamptz(3)
  confirmedAt        DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(3)
  expiredAt          DateTime?    @map("expired_at") @db.Timestamptz(3)
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy        CancelledBy? @map("cancelled_by")
  cancellationReason String?      @map("cancellation_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer           User                @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  agentProfile       AgentProfile        @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  pricingConfig      PricingConfig       @relation(fields: [pricingConfigId], references: [id], onDelete: Restrict)
  lines              BookingLineItem[]
  payments           Payment[]
  refunds            Refund[]
  ledgerEntries      LedgerEntry[]
  earning            AgentEarning?
  conversations      Conversation[]
  discountRedemption DiscountRedemption?
  review             Review?

  @@index([customerId, createdAt(sort: Desc)])
  @@index([agentProfileId, createdAt(sort: Desc)])
  @@index([propertyId, status, startDate])
  @@index([status, holdExpiresAt])
  @@index([status, endDate])
  @@index([createdAt])
  @@map("bookings")
}

enum PriceLineKind {
  RENT
  LISTING_DISCOUNT
  PROMO_DISCOUNT
  AGENCY_FEE
  CLEANING_FEE
  CAUTION_FEE
  SERVICE_FEE
  VAT
}

/// The customer-facing price breakdown, frozen at booking time. Lines sum to
/// `Booking.totalKobo`; discounts are negative.
model BookingLineItem {
  id             String        @id @default(uuid(7)) @db.Uuid
  bookingId      String        @map("booking_id") @db.Uuid
  kind           PriceLineKind
  label          String        @db.VarChar(120)
  quantity       Int?
  unitAmountKobo BigInt?       @map("unit_amount_kobo")
  amountKobo     BigInt        @map("amount_kobo")
  sortOrder      Int           @map("sort_order")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, kind])
  @@map("booking_line_items")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProviderName {
  PAYSTACK
  TEST
}

/// One payment attempt. A booking may have several (retries); only a
/// server-verified SUCCESS confirms it.
model Payment {
  id                    String              @id @default(uuid(7)) @db.Uuid
  bookingId             String              @map("booking_id") @db.Uuid
  provider              PaymentProviderName
  /// Our reference, sent to the provider; unique across all attempts.
  reference             String              @unique @db.VarChar(64)
  amountKobo            BigInt              @map("amount_kobo")
  currency              Currency            @default(NGN)
  status                PaymentStatus       @default(PENDING)
  providerTransactionId String?             @map("provider_transaction_id") @db.VarChar(64)
  failureReason         String?             @map("failure_reason") @db.VarChar(300)
  paidAt                DateTime?           @map("paid_at") @db.Timestamptz(3)
  verifiedAt            DateTime?           @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refund        Refund?
  ledgerEntries LedgerEntry[]

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  /// Revenue reporting by payment date (analytics).
  @@index([paidAt])
  @@map("payments")
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

/// At most one refund per payment, so money can never be returned twice.
model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  bookingId        String       @map("booking_id") @db.Uuid
  paymentId        String       @unique @map("payment_id") @db.Uuid
  amountKobo       BigInt       @map("amount_kobo")
  status           RefundStatus @default(REQUESTED)
  reason           String       @db.VarChar(500)
  requestedBy      CancelledBy  @map("requested_by")
  reviewNote       String?      @map("review_note") @db.VarChar(500)
  reviewedById     String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(64)
  failureReason    String?      @map("failure_reason") @db.VarChar(300)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reviewedBy    User?         @relation("RefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([status, createdAt])
  /// Refunds by completion date (analytics).
  @@index([completedAt])
  @@index([bookingId])
  @@map("refunds")
}

enum LedgerEntryType {
  PLATFORM_SERVICE_FEE
  PLATFORM_COMMISSION
  VAT_PAYABLE
  AGENT_RENT_PAYABLE
  AGENT_CLEANING_PAYABLE
  AGENT_AGENCY_FEE_PAYABLE
  CAUTION_HELD
  UNALLOCATED
}

/// Immutable allocation of captured money. A payment's entries sum to its
/// amount; a refund writes the exact negations. `sourceKey` + `type` is
/// unique, so replayed webhooks can never record anything twice.
model LedgerEntry {
  id         String          @id @default(uuid(7)) @db.Uuid
  /// "payment:<id>" or "refund:<id>".
  sourceKey  String          @map("source_key") @db.VarChar(80)
  type       LedgerEntryType
  amountKobo BigInt          @map("amount_kobo")
  bookingId  String          @map("booking_id") @db.Uuid
  paymentId  String?         @map("payment_id") @db.Uuid
  refundId   String?         @map("refund_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund  Refund?  @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([sourceKey, type])
  @@index([bookingId])
  @@index([type, createdAt])
  @@map("ledger_entries")
}

enum AgentEarningStatus {
  PENDING
  AVAILABLE
  REVERSED
}

/// The agent's share of one paid booking. Becoming AVAILABLE makes it
/// payable; withdrawals (a later phase) are the only way it is paid out.
model AgentEarning {
  id             String             @id @default(uuid(7)) @db.Uuid
  bookingId      String             @unique @map("booking_id") @db.Uuid
  agentProfileId String             @map("agent_profile_id") @db.Uuid
  amountKobo     BigInt             @map("amount_kobo")
  status         AgentEarningStatus @default(PENDING)
  availableAt    DateTime?          @map("available_at") @db.Timestamptz(3)
  reversedAt     DateTime?          @map("reversed_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)

  @@index([agentProfileId, status])
  @@map("agent_earnings")
}

// ─── Phase 4: agent subscriptions ────────────────────────────────────────────

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionPlanStatus {
  /// Offered to agents.
  ACTIVE
  /// Not offered; existing subscribers keep it until their term ends.
  INACTIVE
  /// Retired. Kept for history; never offered again.
  ARCHIVED
}

/// What a plan limits. A missing entitlement row means "not included" (0);
/// a row with a null limit means unlimited.
enum EntitlementKey {
  PROPERTY_COUNT
  IMAGES_PER_PROPERTY
  VIDEOS_PER_PROPERTY
  FEATURED_PROPERTY_COUNT
  STORAGE_MB
  EVENT_COUNT
  TOUR_COUNT
  CLEANING_SERVICE_COUNT
  HOTEL_COUNT
}

enum AgentSubscriptionStatus {
  /// Paid for; starts when the agent's current term ends.
  PENDING
  ACTIVE
  /// Ended early (agent/admin cancellation, or replaced by an upgrade).
  CANCELLED
  /// Term ran out.
  EXPIRED
  /// Paused by an administrator; the agent falls back to the default plan.
  SUSPENDED
}

enum SubscriptionChangeType {
  NEW
  RENEWAL
  UPGRADE
  DOWNGRADE
}

/// Admin-managed plan. Exactly one plan is the free default (price 0, no
/// interval) that every agent without a paid term is on.
model SubscriptionPlan {
  id              String                 @id @default(uuid(7)) @db.Uuid
  slug            String                 @unique @db.VarChar(60)
  name            String                 @db.VarChar(60)
  description     String?                @db.VarChar(500)
  status          SubscriptionPlanStatus @default(ACTIVE)
  isDefault       Boolean                @default(false) @map("is_default")
  /// Price per billing interval, in kobo. 0 only for the default plan.
  priceKobo       BigInt                 @default(0) @map("price_kobo")
  currency        Currency               @default(NGN)
  /// Null only for the default (free) plan.
  billingInterval BillingInterval?       @map("billing_interval")
  /// Tier order: a higher rank is an upgrade, lower or equal a downgrade.
  rank            Int                    @default(0)
  /// Short selling points shown on the comparison page.
  features        String[]               @default([])
  createdById     String?                @map("created_by_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User?                         @relation("SubscriptionPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entitlements  SubscriptionPlanEntitlement[]
  subscriptions AgentSubscription[]
  payments      SubscriptionPayment[]

  @@index([status, rank])
  @@map("subscription_plans")
}

model SubscriptionPlanEntitlement {
  planId String         @map("plan_id") @db.Uuid
  key    EntitlementKey
  /// Null = unlimited.
  limit  Int?

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, key])
  @@map("subscription_plan_entitlements")
}

/// One paid term of one plan. Rows are history: they change status but are
/// never deleted (enforced by trigger). At most one ACTIVE row per agent.
model AgentSubscription {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  agentProfileId     String                  @map("agent_profile_id") @db.Uuid
  planId             String                  @map("plan_id") @db.Uuid
  status             AgentSubscriptionStatus
  changeType         SubscriptionChangeType  @map("change_type")
  /// What the agent paid for this term (frozen; plan prices may change).
  priceKobo          BigInt                  @map("price_kobo")
  currency           Currency                @default(NGN)
  billingInterval    BillingInterval         @map("billing_interval")
  currentPeriodStart DateTime                @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime                @map("current_period_end") @db.Timestamptz(3)
  startedAt          DateTime?               @map("started_at") @db.Timestamptz(3)
  /// The agent asked to stop at the end of the current period.
  cancelAtPeriodEnd  Boolean                 @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  endedAt            DateTime?               @map("ended_at") @db.Timestamptz(3)
  endReason          String?                 @map("end_reason") @db.VarChar(200)
  suspendedAt        DateTime?               @map("suspended_at") @db.Timestamptz(3)
  expiryReminderAt   DateTime?               @map("expiry_reminder_at") @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  agentProfile AgentProfile          @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments     SubscriptionPayment[]

  @@index([agentProfileId, status])
  @@index([status, currentPeriodEnd])
  @@index([planId, status])
  @@map("agent_subscriptions")
}

/// A payment attempt for a subscription term, through the same provider
/// abstraction as bookings. Amount, plan and reference are frozen at
/// checkout (trigger-enforced); the term is created only after the provider
/// verifies the payment server-side.
model SubscriptionPayment {
  id                    String              @id @default(uuid(7)) @db.Uuid
  agentProfileId        String              @map("agent_profile_id") @db.Uuid
  planId                String              @map("plan_id") @db.Uuid
  /// The term this payment bought; set when the payment is applied.
  subscriptionId        String?             @map("subscription_id") @db.Uuid
  provider              PaymentProviderName
  /// "HHS-…", unique across all attempts.
  reference             String              @unique @db.VarChar(64)
  amountKobo            BigInt              @map("amount_kobo")
  currency              Currency            @default(NGN)
  billingInterval       BillingInterval     @map("billing_interval")
  /// Plan name at checkout, for receipts if the plan is renamed later.
  planName              String              @map("plan_name") @db.VarChar(60)
  /// Taken off the plan price by a discount code; amountKobo is what was charged.
  discountKobo          BigInt              @default(0) @map("discount_kobo")
  /// The code as entered (snapshot for receipts).
  discountCode          String?             @map("discount_code") @db.VarChar(32)
  status                PaymentStatus       @default(PENDING)
  providerTransactionId String?             @map("provider_transaction_id") @db.VarChar(64)
  failureReason         String?             @map("failure_reason") @db.VarChar(300)
  paidAt                DateTime?           @map("paid_at") @db.Timestamptz(3)
  verifiedAt            DateTime?           @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  agentProfile       AgentProfile        @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  plan               SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription       AgentSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  discountRedemption DiscountRedemption?

  @@index([agentProfileId, createdAt])
  @@index([status, createdAt])
  /// Subscription revenue by payment date (analytics, admin metrics).
  @@index([paidAt])
  @@map("subscription_payments")
}

// ─── Phase 5: communication ──────────────────────────────────────────────────

/// What a conversation is about. Each type has its own nullable foreign key
/// on Conversation (no polymorphic ids). Phase 6 added EXPERIENCE (events,
/// tours, hotels, cleaning) with one new column, without touching existing rows.
enum ConversationContextType {
  PROPERTY
  BOOKING
  EXPERIENCE
  /// Phase 7: a customer or agent asking HavenHub support for help.
  SUPPORT
}

enum ConversationStatus {
  OPEN
  /// Closed by a moderator: readable, but no new messages.
  CLOSED
}

enum ParticipantRole {
  CUSTOMER
  AGENT
  ADMIN
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
}

enum AttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

model Conversation {
  id             String                  @id @default(uuid(7)) @db.Uuid
  contextType    ConversationContextType @map("context_type")
  propertyId     String?                 @map("property_id") @db.Uuid
  bookingId      String?                 @map("booking_id") @db.Uuid
  experienceId   String?                 @map("experience_id") @db.Uuid
  /// Deterministic identity for get-or-create (e.g. "property:<id>:customer:<id>").
  contextKey     String                  @unique @map("context_key") @db.VarChar(160)
  status         ConversationStatus      @default(OPEN)
  closedAt       DateTime?               @map("closed_at") @db.Timestamptz(3)
  closedById     String?                 @map("closed_by_id") @db.Uuid
  closedReason   String?                 @map("closed_reason") @db.VarChar(500)
  /// Highest message seq allocated; incremented under the row lock.
  lastSeq        Int                     @default(0) @map("last_seq")
  lastMessageId  String?                 @unique @map("last_message_id") @db.Uuid
  lastActivityAt DateTime                @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  property     Property?                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  booking      Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  experience   Experience?               @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  closedBy     User?                     @relation("ConversationCloser", fields: [closedById], references: [id], onDelete: SetNull)
  lastMessage  Message?                  @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]                 @relation("ConversationMessages")
  attachments  MessageAttachment[]

  @@index([lastActivityAt(sort: Desc), id])
  @@index([propertyId])
  @@index([bookingId])
  @@index([experienceId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId  String          @map("conversation_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  role            ParticipantRole
  /// Read cursor: every message with seq <= lastReadSeq has been read.
  lastReadSeq     Int             @default(0) @map("last_read_seq")
  lastReadAt      DateTime?       @map("last_read_at") @db.Timestamptz(3)
  /// Highest seq already covered by an email digest (no repeat emails).
  lastNotifiedSeq Int             @default(0) @map("last_notified_seq")
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  joinedAt        DateTime        @default(now()) @map("joined_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId, archivedAt])
  @@map("conversation_participants")
}

/// Messages are never hard-deleted: deletion is a soft flag and the content is
/// redacted from every API response; edits keep their previous text in
/// MessageRevision for moderation.
model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// Position in the conversation (1, 2, 3…): stable order and cursors.
  seq            Int
  senderId       String?     @map("sender_id") @db.Uuid
  type           MessageType
  body           String?     @db.VarChar(4000)
  replyToId      String?     @map("reply_to_id") @db.Uuid
  /// Client-generated idempotency key; unique per sender.
  clientKey      String?     @map("client_key") @db.VarChar(64)
  /// Structured data for SYSTEM messages only.
  metadata       Json?
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?     @map("deleted_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation        @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  deletedBy    User?               @relation("MessageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  replyTo      Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: Restrict)
  replies      Message[]           @relation("MessageReplies")
  lastOf       Conversation?       @relation("ConversationLastMessage")
  attachments  MessageAttachment[]
  reactions    MessageReaction[]
  revisions    MessageRevision[]

  @@unique([conversationId, seq])
  @@unique([senderId, clientKey])
  @@index([replyToId])
  @@map("messages")
}

model MessageRevision {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  /// The text as it was before this edit.
  body      String?  @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("message_revisions")
}

/// Uploaded before the message is sent, then attached to it. Files live in
/// private storage under `chat/`; clients only ever see API download URLs.
model MessageAttachment {
  id             String         @id @default(uuid(7)) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  uploaderId     String         @map("uploader_id") @db.Uuid
  messageId      String?        @map("message_id") @db.Uuid
  kind           AttachmentKind
  storageKey     String         @unique @map("storage_key") @db.VarChar(300)
  thumbnailKey   String?        @map("thumbnail_key") @db.VarChar(300)
  contentType    String         @map("content_type") @db.VarChar(100)
  /// Sanitised display name; never used as a storage path.
  fileName       String         @map("file_name") @db.VarChar(160)
  bytes          Int
  width          Int?
  height         Int?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([conversationId, uploaderId, messageId])
  @@index([createdAt])
  @@map("message_attachments")
}

/// One reaction per user per message (changing it replaces it).
model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// One of the allowed reactions (see @havenhub/shared MESSAGE_REACTIONS).
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([messageId, userId])
  @@index([messageId, emoji])
  @@map("message_reactions")
}

// ─── Phase 6: events & experiences (catalogue only) ──────────────────────────
//
// Listings only: nothing here takes payment. Ticket types, tour dates, hotel
// room prices and availability are catalogue information; purchasing comes in
// a later phase once its business rules are defined.

enum ExperienceKind {
  EVENT
  TOUR
  HOTEL
  CLEANING
}

/// Same lifecycle (and values) as PropertyStatus; moderated the same way.
enum ExperienceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum TicketTypeKind {
  REGULAR
  VIP
  VVIP
  EARLY_BIRD
  GROUP
}

enum TourCategory {
  ZOO_TOUR
  CITY_TOUR
  CULTURAL_EXPERIENCE
  ADVENTURE_ACTIVITY
  TOURIST_ATTRACTION
  GUIDED_TOUR
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// The record behind every event, tour, hotel and cleaning service:
/// ownership, lifecycle, moderation, location and media. Kind-specific
/// details live in the 1:1 tables below.
model Experience {
  id              String           @id @default(uuid(7)) @db.Uuid
  kind            ExperienceKind
  agentProfileId  String           @map("agent_profile_id") @db.Uuid
  slug            String           @unique @db.VarChar(160)
  status          ExperienceStatus @default(DRAFT)
  title           String           @db.VarChar(120)
  description     String?          @db.VarChar(5000)
  /// "X% off" shown on the listing (1–90). Customers arrange payment with the
  /// provider; there is no experience checkout yet.
  discountPercent Int?             @map("discount_percent") @db.SmallInt

  addressLine String?  @map("address_line") @db.VarChar(240)
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(60)
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  moderationNote String?   @map("moderation_note") @db.VarChar(1000)
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(3)
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewerId     String?   @map("reviewer_id") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  agentProfile  AgentProfile             @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  reviewer      User?                    @relation("ExperienceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  event         Event?
  tour          Tour?
  hotel         Hotel?
  cleaning      CleaningService?
  images        ExperienceImage[]
  videos        ExperienceVideo[]
  amenities     ExperienceAmenity[]
  zones         VacationZoneExperience[]
  conversations Conversation[]

  @@index([agentProfileId, kind, status])
  @@index([kind, status, publishedAt(sort: Desc)])
  @@index([kind, status, state, city])
  @@map("experiences")
}

model ExperienceImage {
  id           String   @id @default(uuid(7)) @db.Uuid
  experienceId String   @map("experience_id") @db.Uuid
  storageKey   String   @map("storage_key") @db.VarChar(300)
  thumbnailKey String   @map("thumbnail_key") @db.VarChar(300)
  width        Int
  height       Int
  bytes        Int
  altText      String?  @map("alt_text") @db.VarChar(200)
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, sortOrder])
  @@map("experience_images")
}

model ExperienceVideo {
  id           String        @id @default(uuid(7)) @db.Uuid
  experienceId String        @map("experience_id") @db.Uuid
  provider     VideoProvider
  externalId   String        @map("external_id") @db.VarChar(40)
  title        String?       @db.VarChar(120)
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, provider, externalId])
  @@map("experience_videos")
}

model ExperienceAmenity {
  experienceId String @map("experience_id") @db.Uuid
  amenityId    String @map("amenity_id") @db.Uuid

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  amenity    Amenity    @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([experienceId, amenityId])
  @@index([amenityId])
  @@map("experience_amenities")
}

/// §22. Start and end are instants (displayed in Nigerian time).
model Event {
  experienceId String    @id @map("experience_id") @db.Uuid
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(3)
  capacity     Int?
  organizer    String?   @db.VarChar(160)
  terms        String?   @db.VarChar(5000)
  hospitality  String?   @db.VarChar(2000)

  experience  Experience        @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  ticketTypes EventTicketType[]

  @@index([startsAt])
  @@map("events")
}

/// A ticket type and its listed price — catalogue only, not sold yet.
model EventTicketType {
  id          String         @id @default(uuid(7)) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  kind        TicketTypeKind
  name        String         @db.VarChar(80)
  description String?        @db.VarChar(500)
  priceKobo   BigInt         @map("price_kobo")
  sortOrder   Int            @default(0) @map("sort_order")

  event Event @relation(fields: [eventId], references: [experienceId], onDelete: Cascade)

  @@unique([eventId, name])
  @@map("event_ticket_types")
}

/// §24.
model Tour {
  experienceId String        @id @map("experience_id") @db.Uuid
  category     TourCategory?
  /// Listed price; `priceNote` says what it covers (e.g. "per person").
  priceKobo    BigInt?       @map("price_kobo")
  priceNote    String?       @map("price_note") @db.VarChar(120)
  capacity     Int?

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  dates      TourDate[]

  @@map("tours")
}

/// When a tour runs (its availability).
model TourDate {
  id       String   @id @default(uuid(7)) @db.Uuid
  tourId   String   @map("tour_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)

  tour Tour @relation(fields: [tourId], references: [experienceId], onDelete: Cascade)

  @@unique([tourId, startsAt])
  @@map("tour_dates")
}

/// §25. Hospitality, food and cleaning are described in text; each room has
/// its own price and per-date availability (catalogue information only).
model Hotel {
  experienceId String  @id @map("experience_id") @db.Uuid
  hospitality  String? @db.VarChar(2000)
  food         String? @db.VarChar(2000)
  cleaning     String? @db.VarChar(2000)

  experience Experience      @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  roomTypes  HotelRoomType[]
  rooms      HotelRoom[]

  @@map("hotels")
}

model HotelRoomType {
  id          String  @id @default(uuid(7)) @db.Uuid
  hotelId     String  @map("hotel_id") @db.Uuid
  name        String  @db.VarChar(80)
  description String? @db.VarChar(1000)
  maxGuests   Int?    @map("max_guests") @db.SmallInt
  /// Listed nightly price for rooms of this type.
  priceKobo   BigInt  @map("price_kobo")
  sortOrder   Int     @default(0) @map("sort_order")

  hotel Hotel       @relation(fields: [hotelId], references: [experienceId], onDelete: Cascade)
  rooms HotelRoom[]

  @@unique([hotelId, name])
  @@map("hotel_room_types")
}

model HotelRoom {
  id         String  @id @default(uuid(7)) @db.Uuid
  hotelId    String  @map("hotel_id") @db.Uuid
  roomTypeId String  @map("room_type_id") @db.Uuid
  /// Room number or name.
  label      String  @db.VarChar(40)
  /// Overrides the room type's nightly price for this room.
  priceKobo  BigInt? @map("price_kobo")
  active     Boolean @default(true)

  hotel        Hotel                   @relation(fields: [hotelId], references: [experienceId], onDelete: Cascade)
  roomType     HotelRoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  availability HotelRoomAvailability[]

  @@unique([hotelId, label])
  @@index([roomTypeId])
  @@map("hotel_rooms")
}

/// A date-specific override for one room: closed and/or a different nightly
/// price. Dates without a row follow the room's defaults.
model HotelRoomAvailability {
  roomId    String   @map("room_id") @db.Uuid
  date      DateTime @db.Date
  available Boolean
  priceKobo BigInt?  @map("price_kobo")

  room HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, date])
  @@map("hotel_room_availability")
}

/// §14. Posting a cleaning service never requires a paid plan.
model CleaningService {
  experienceId     String    @id @map("experience_id") @db.Uuid
  /// Listed price; `priceNote` says what it covers (e.g. "per visit").
  priceKobo        BigInt?   @map("price_kobo")
  priceNote        String?   @map("price_note") @db.VarChar(120)
  serviceAreas     String[]  @default([]) @map("service_areas")
  availableDays    Weekday[] @default([]) @map("available_days")
  availabilityNote String?   @map("availability_note") @db.VarChar(300)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@map("cleaning_services")
}

/// §23. Admin-managed destination content.
model VacationZone {
  id                String   @id @default(uuid(7)) @db.Uuid
  slug              String   @unique @db.VarChar(80)
  name              String   @db.VarChar(120)
  state             String?  @db.VarChar(60)
  description       String?  @db.VarChar(5000)
  accommodation     String?  @db.VarChar(2000)
  /// Indicative price range shown to visitors (not a charge).
  priceRangeMinKobo BigInt?  @map("price_range_min_kobo")
  priceRangeMaxKobo BigInt?  @map("price_range_max_kobo")
  activities        String[] @default([])
  offers            String?  @db.VarChar(2000)
  hospitality       String?  @db.VarChar(2000)
  nearbyAttractions String[] @default([]) @map("nearby_attractions")
  published         Boolean  @default(false)
  coverKey          String?  @map("cover_key") @db.VarChar(300)
  coverThumbKey     String?  @map("cover_thumb_key") @db.VarChar(300)
  coverBytes        Int?     @map("cover_bytes")
  sortOrder         Int      @default(0) @map("sort_order")
  createdById       String?  @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  experiences VacationZoneExperience[]

  @@index([published, sortOrder])
  @@map("vacation_zones")
}

/// Published tours and hotels an administrator features in a destination.
model VacationZoneExperience {
  zoneId       String @map("zone_id") @db.Uuid
  experienceId String @map("experience_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  zone       VacationZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  experience Experience   @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([zoneId, experienceId])
  @@index([experienceId])
  @@map("vacation_zone_experiences")
}

// ─── Phase 7: CMS ────────────────────────────────────────────────────────────
//
// Site content, homepage builder, static pages, blog, help centre, careers,
// SEO and newsletter. Long-form text is Markdown source; it is rendered by an
// allow-listing renderer (no raw HTML), never injected as HTML.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomepageSectionKey {
  HERO
  EXPLORE
  FEATURED_PROPERTIES
  POPULAR_LOCATIONS
  RENT_PROPERTIES
  SALE_PROPERTIES
  VACATION_ZONES
  HOTELS
  EVENTS
  TOURS
  CLEANING
  SPECIAL_OFFERS
  AWARDS
  BLOG
  TESTIMONIALS
  CTA
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

enum SubscriberStatus {
  /// Signed up; waiting for the email confirmation (double opt-in).
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}

enum SubscriberEventType {
  REQUESTED
  CONFIRMED
  UNSUBSCRIBED
  /// Personal data removed by the retention job (the record itself stays).
  ERASED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// The one row of site-wide content and switches (id is always 1).
model SiteSettings {
  id             Int     @id @default(1)
  siteName       String  @default("HavenHub") @map("site_name") @db.VarChar(60)
  tagline        String? @db.VarChar(160)
  logoKey        String? @map("logo_key") @db.VarChar(300)
  logoWidth      Int?    @map("logo_width")
  logoHeight     Int?    @map("logo_height")
  faviconKey     String? @map("favicon_key") @db.VarChar(300)
  contactEmail   String? @map("contact_email") @db.VarChar(254)
  contactPhone   String? @map("contact_phone") @db.VarChar(40)
  contactAddress String? @map("contact_address") @db.VarChar(300)
  /// [{ network, url }] — validated by the API.
  socialLinks    Json    @default("[]") @map("social_links")
  footerText     String? @map("footer_text") @db.VarChar(500)

  blogEnabled             Boolean @default(true) @map("blog_enabled")
  careersEnabled          Boolean @default(false) @map("careers_enabled")
  helpCenterEnabled       Boolean @default(false) @map("help_center_enabled")
  newsletterEnabled       Boolean @default(false) @map("newsletter_enabled")
  /// Shown next to the signup checkbox and stored with every consent record.
  newsletterConsentText   String? @map("newsletter_consent_text") @db.VarChar(1000)
  /// Require email confirmation before a subscriber receives campaigns.
  newsletterDoubleOptIn   Boolean @default(true) @map("newsletter_double_opt_in")
  /// CVs older than this are deleted by the retention job; null keeps them.
  cvRetentionDays         Int?    @map("cv_retention_days")
  /// Unsubscribed or never-confirmed subscribers are anonymised this many
  /// days later; null keeps them.
  newsletterRetentionDays Int?    @map("newsletter_retention_days")

  seoTitle        String?  @map("seo_title") @db.VarChar(70)
  seoDescription  String?  @map("seo_description") @db.VarChar(200)
  seoKeywords     String[] @default([]) @map("seo_keywords")
  ogImageId       String?  @map("og_image_id") @db.Uuid
  twitterHandle   String?  @map("twitter_handle") @db.VarChar(16)
  allowIndexing   Boolean  @default(true) @map("allow_indexing")
  /// Extra paths kept out of robots.txt (private areas are always excluded).
  robotsDisallow  String[] @default([]) @map("robots_disallow")
  /// Which public sections appear in sitemap.xml.
  sitemapSections String[] @default([]) @map("sitemap_sections")

  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ogImage   CmsMedia? @relation("SiteOgImage", fields: [ogImageId], references: [id], onDelete: Restrict)
  updatedBy User?     @relation("SiteSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model HomepageSection {
  key       HomepageSectionKey @id
  enabled   Boolean            @default(false)
  sortOrder Int                @default(0) @map("sort_order")
  title     String?            @db.VarChar(120)
  subtitle  String?            @db.VarChar(300)
  /// Section-specific settings, validated per key by the API.
  config    Json               @default("{}")
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("homepage_sections")
}

/// Images uploaded for CMS content (public, re-encoded WebP).
model CmsMedia {
  id           String   @id @default(uuid(7)) @db.Uuid
  storageKey   String   @unique @map("storage_key") @db.VarChar(300)
  thumbnailKey String   @map("thumbnail_key") @db.VarChar(300)
  width        Int
  height       Int
  bytes        Int
  altText      String?  @map("alt_text") @db.VarChar(200)
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  uploadedBy   User?          @relation("CmsMediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  pagesOg      Page[]         @relation("PageOgImage")
  postsCover   BlogPost[]     @relation("BlogPostCover")
  testimonials Testimonial[]
  seoRoutes    SeoRoute[]
  siteOg       SiteSettings[] @relation("SiteOgImage")
  popups       Popup[]
  badges       Badge[]

  @@index([createdAt(sort: Desc)])
  @@map("cms_media")
}

/// About, Contact, Terms, Privacy and any custom page.
model Page {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String        @unique @db.VarChar(80)
  title          String        @db.VarChar(160)
  body           String        @default("")
  status         ContentStatus @default(DRAFT)
  /// Built-in pages (about, contact, terms, privacy) keep their slug and cannot be deleted.
  system         Boolean       @default(false)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(3)
  seoTitle       String?       @map("seo_title") @db.VarChar(70)
  seoDescription String?       @map("seo_description") @db.VarChar(200)
  ogImageId      String?       @map("og_image_id") @db.Uuid
  noIndex        Boolean       @default(false) @map("no_index")
  updatedById    String?       @map("updated_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  ogImage   CmsMedia? @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: Restrict)
  updatedBy User?     @relation("PageUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("pages")
}

model BlogCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPost {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String        @unique @db.VarChar(160)
  title          String        @db.VarChar(160)
  excerpt        String?       @db.VarChar(400)
  body           String        @default("")
  status         ContentStatus @default(DRAFT)
  /// Publication time; a PUBLISHED post with a future time is "scheduled".
  publishAt      DateTime?     @map("publish_at") @db.Timestamptz(3)
  coverImageId   String?       @map("cover_image_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  authorId       String?       @map("author_id") @db.Uuid
  /// Byline shown publicly (defaults to the author's name).
  authorName     String?       @map("author_name") @db.VarChar(120)
  readingMinutes Int           @default(1) @map("reading_minutes")
  seoTitle       String?       @map("seo_title") @db.VarChar(70)
  seoDescription String?       @map("seo_description") @db.VarChar(200)
  seoKeywords    String[]      @default([]) @map("seo_keywords")
  canonicalUrl   String?       @map("canonical_url") @db.VarChar(500)
  noIndex        Boolean       @default(false) @map("no_index")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  coverImage CmsMedia?          @relation("BlogPostCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  category   BlogCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author     User?              @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tags       BlogPostTag[]
  related    BlogPostRelation[] @relation("PostRelated")
  relatedTo  BlogPostRelation[] @relation("PostRelatedTo")

  @@index([status, publishAt(sort: Desc)])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogPostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

/// Hand-picked related posts, in display order.
model BlogPostRelation {
  postId    String @map("post_id") @db.Uuid
  relatedId String @map("related_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  post    BlogPost @relation("PostRelated", fields: [postId], references: [id], onDelete: Cascade)
  related BlogPost @relation("PostRelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([postId, relatedId])
  @@index([relatedId])
  @@map("blog_post_relations")
}

model HelpCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  articles HelpArticle[]
  faqs     Faq[]

  @@map("help_categories")
}

model HelpArticle {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String        @unique @db.VarChar(160)
  title          String        @db.VarChar(160)
  summary        String?       @db.VarChar(300)
  body           String        @default("")
  status         ContentStatus @default(DRAFT)
  categoryId     String        @map("category_id") @db.Uuid
  sortOrder      Int           @default(0) @map("sort_order")
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(3)
  seoTitle       String?       @map("seo_title") @db.VarChar(70)
  seoDescription String?       @map("seo_description") @db.VarChar(200)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, status, sortOrder])
  @@map("help_articles")
}

model Faq {
  id         String   @id @default(uuid(7)) @db.Uuid
  question   String   @db.VarChar(300)
  answer     String
  categoryId String?  @map("category_id") @db.Uuid
  published  Boolean  @default(false)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category HelpCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([published, sortOrder])
  @@map("faqs")
}

model Testimonial {
  id         String   @id @default(uuid(7)) @db.Uuid
  quote      String   @db.VarChar(600)
  authorName String   @map("author_name") @db.VarChar(120)
  authorRole String?  @map("author_role") @db.VarChar(120)
  photoId    String?  @map("photo_id") @db.Uuid
  published  Boolean  @default(false)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  photo CmsMedia? @relation(fields: [photoId], references: [id], onDelete: Restrict)

  @@index([published, sortOrder])
  @@map("testimonials")
}

/// SEO overrides for fixed public routes (e.g. "/", "/properties", "/blog").
model SeoRoute {
  path        String   @id @db.VarChar(120)
  title       String?  @db.VarChar(70)
  description String?  @db.VarChar(200)
  ogImageId   String?  @map("og_image_id") @db.Uuid
  noIndex     Boolean  @default(false) @map("no_index")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ogImage CmsMedia? @relation(fields: [ogImageId], references: [id], onDelete: Restrict)

  @@map("seo_routes")
}

model JobPosting {
  id             String         @id @default(uuid(7)) @db.Uuid
  slug           String         @unique @db.VarChar(160)
  title          String         @db.VarChar(160)
  department     String?        @db.VarChar(80)
  location       String         @db.VarChar(160)
  employmentType EmploymentType @map("employment_type")
  description    String         @default("")
  requirements   String         @default("")
  status         JobStatus      @default(DRAFT)
  publishedAt    DateTime?      @map("published_at") @db.Timestamptz(3)
  closesAt       DateTime?      @map("closes_at") @db.Timestamptz(3)
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz(3)
  seoTitle       String?        @map("seo_title") @db.VarChar(70)
  seoDescription String?        @map("seo_description") @db.VarChar(200)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  applications JobApplication[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("job_postings")
}

/// Applicant personal data: only users with `careers.applications` see it.
model JobApplication {
  id              String            @id @default(uuid(7)) @db.Uuid
  jobId           String            @map("job_id") @db.Uuid
  fullName        String            @map("full_name") @db.VarChar(120)
  /// Lower-cased.
  email           String            @db.VarChar(254)
  phone           String            @db.VarChar(20)
  coverNote       String?           @map("cover_note") @db.VarChar(4000)
  /// Private storage key (careers/…); never served publicly. Null once deleted.
  cvKey           String?           @map("cv_key") @db.VarChar(300)
  cvFileName      String            @map("cv_file_name") @db.VarChar(200)
  cvContentType   String            @map("cv_content_type") @db.VarChar(120)
  cvBytes         Int               @map("cv_bytes")
  cvDeletedAt     DateTime?         @map("cv_deleted_at") @db.Timestamptz(3)
  status          ApplicationStatus @default(NEW)
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  statusChangedAt DateTime?         @map("status_changed_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  job        JobPosting @relation(fields: [jobId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([jobId, email])
  @@index([jobId, status, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("job_applications")
}

model EmailSubscriber {
  id                    String           @id @default(uuid(7)) @db.Uuid
  /// Lower-cased.
  email                 String           @unique @db.VarChar(254)
  status                SubscriberStatus @default(PENDING)
  /// The consent statement the person agreed to, as shown at the time.
  consentText           String?          @map("consent_text") @db.VarChar(1000)
  consentSource         String?          @map("consent_source") @db.VarChar(60)
  consentAt             DateTime?        @map("consent_at") @db.Timestamptz(3)
  confirmedAt           DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  unsubscribedAt        DateTime?        @map("unsubscribed_at") @db.Timestamptz(3)
  /// SHA-256 of the confirmation secret (double opt-in); cleared once used.
  confirmTokenHash      String?          @unique @map("confirm_token_hash") @db.Char(64)
  confirmTokenExpiresAt DateTime?        @map("confirm_token_expires_at") @db.Timestamptz(3)
  /// SHA-256 of the unsubscribe secret carried in every campaign email.
  unsubscribeTokenHash  String           @unique @map("unsubscribe_token_hash") @db.Char(64)
  /// Set when the retention job removed the address (see SiteSettings).
  erasedAt              DateTime?        @map("erased_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  events     EmailSubscriberEvent[]
  deliveries EmailCampaignDelivery[]

  @@index([status])
  @@map("email_subscribers")
}

/// Append-only consent history (who agreed to what, and when they withdrew).
model EmailSubscriberEvent {
  id           String              @id @default(uuid(7)) @db.Uuid
  subscriberId String              @map("subscriber_id") @db.Uuid
  type         SubscriberEventType
  source       String?             @db.VarChar(60)
  consentText  String?             @map("consent_text") @db.VarChar(1000)
  /// Hashed, never the raw address.
  ipHash       String?             @map("ip_hash") @db.Char(64)
  actorId      String?             @map("actor_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  subscriber EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@index([subscriberId, createdAt])
  @@map("email_subscriber_events")
}

model EmailCampaign {
  id          String         @id @default(uuid(7)) @db.Uuid
  name        String         @db.VarChar(120)
  subject     String         @db.VarChar(160)
  body        String
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?      @map("scheduled_at") @db.Timestamptz(3)
  startedAt   DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy  User?                   @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries EmailCampaignDelivery[]

  @@index([status, scheduledAt])
  @@map("email_campaigns")
}

/// One row per campaign and subscriber: the unique pair makes sending idempotent.
model EmailCampaignDelivery {
  id           String         @id @default(uuid(7)) @db.Uuid
  campaignId   String         @map("campaign_id") @db.Uuid
  subscriberId String         @map("subscriber_id") @db.Uuid
  status       DeliveryStatus @default(PENDING)
  error        String?        @db.VarChar(300)
  claimedAt    DateTime?      @map("claimed_at") @db.Timestamptz(3)
  sentAt       DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  campaign   EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  subscriber EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@map("email_campaign_deliveries")
}

// ─── Platform configuration (Phase 8) ────────────────────────────────────────

enum SmtpSecurity {
  /// Implicit TLS (usually port 465).
  TLS
  /// STARTTLS required (usually port 587).
  STARTTLS
}

/// Admin-managed outgoing email server (one row, id = 1). When present it
/// overrides the SMTP_* environment variables. The password is stored only
/// as AES-256-GCM ciphertext under a key derived from FIELD_ENCRYPTION_KEY.
model SmtpSettings {
  id                 Int          @id @default(1)
  host               String       @db.VarChar(253)
  port               Int
  security           SmtpSecurity
  username           String?      @db.VarChar(254)
  passwordCiphertext String?      @map("password_ciphertext") @db.VarChar(1024)
  fromEmail          String       @map("from_email") @db.VarChar(254)
  fromName           String       @map("from_name") @db.VarChar(100)
  /// Bumped on every change; API instances rebuild their transport when it moves.
  version            Int          @default(1)
  updatedById        String?      @map("updated_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("SmtpSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("smtp_settings")
}

/// Maintenance mode and the moderation policy (one row, id = 1).
model PlatformSettings {
  id                    Int       @id @default(1)
  maintenanceEnabled    Boolean   @default(false) @map("maintenance_enabled")
  maintenanceMessage    String?   @map("maintenance_message") @db.VarChar(500)
  maintenanceReturnText String?   @map("maintenance_return_text") @db.VarChar(200)
  maintenanceUpdatedAt  DateTime? @map("maintenance_updated_at") @db.Timestamptz(3)
  /// true = admin review is required before a listing of this type is published.
  reviewProperties      Boolean   @default(true) @map("review_properties")
  reviewEvents          Boolean   @default(true) @map("review_events")
  reviewTours           Boolean   @default(true) @map("review_tours")
  reviewHotels          Boolean   @default(true) @map("review_hotels")
  reviewCleaning        Boolean   @default(true) @map("review_cleaning")
  /// Admin policies by area (security, storage, booking, refunds, chat, events,
  /// notifications). Validated by the shared schema; missing values take
  /// their built-in defaults, so `{}` is HavenHub's default behaviour.
  policies              Json      @default("{}") @db.JsonB
  policiesUpdatedAt     DateTime? @map("policies_updated_at") @db.Timestamptz(3)
  updatedById           String?   @map("updated_by_id") @db.Uuid
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("PlatformSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// ── Notifications (in-app) ──────────────────────────────────────────────────

/// One entry in a user's in-app inbox. Written in the same transaction as the
/// change it describes; title/body are stored as shown (no re-rendering).
model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// A NotificationType from the shared package (kept as text so new types
  /// need no migration).
  type        String    @db.VarChar(60)
  title       String    @db.VarChar(160)
  body        String    @db.VarChar(1000)
  /// Relative path inside the web app (always starts with "/").
  link        String?   @db.VarChar(500)
  broadcastId String?   @map("broadcast_id") @db.Uuid
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// An announcement an administrator sent to an audience (history + audit).
model NotificationBroadcast {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// ALL | CUSTOMERS | AGENTS | USER
  audience       String   @db.VarChar(20)
  /// Set when audience = USER.
  recipientEmail String?  @map("recipient_email") @db.VarChar(254)
  title          String   @db.VarChar(160)
  body           String   @db.VarChar(1000)
  link           String?  @db.VarChar(500)
  recipientCount Int      @map("recipient_count")
  sentById       String?  @map("sent_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sentBy        User?          @relation("NotificationBroadcastSender", fields: [sentById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([createdAt(sort: Desc)])
  @@map("notification_broadcasts")
}

// ── Discount codes ──────────────────────────────────────────────────────────

/// A discount code. `scope` says what it discounts: SUBSCRIPTION (agent
/// plans; offered by administrators) or BOOKING (property stays; offered by
/// the agent who owns them). Exactly one of percentOff / amountOffKobo.
model DiscountCode {
  id                  String    @id @default(uuid(7)) @db.Uuid
  /// Upper-case; unique per owner.
  code                String    @db.VarChar(32)
  scope               String    @db.VarChar(20)
  /// "PLATFORM" or the owning agent profile's id (codes are unique per owner).
  ownerKey            String    @default("PLATFORM") @map("owner_key") @db.VarChar(40)
  /// Set for BOOKING codes: the agent who offers (and pays for) the discount.
  ownerAgentProfileId String?   @map("owner_agent_profile_id") @db.Uuid
  /// BOOKING codes: the owner's properties it applies to; empty = all of them.
  propertyIds         String[]  @default([]) @map("property_ids") @db.Uuid
  /// Internal note for administrators (never shown to agents).
  description         String?   @db.VarChar(300)
  percentOff          Int?      @map("percent_off")
  amountOffKobo       BigInt?   @map("amount_off_kobo")
  /// Plans it applies to; empty = every paid plan.
  planIds             String[]  @default([]) @map("plan_ids") @db.Uuid
  /// Agents who may use it; empty = any agent.
  agentProfileIds     String[]  @default([]) @map("agent_profile_ids") @db.Uuid
  startsAt            DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime? @map("ends_at") @db.Timestamptz(3)
  /// Total uses; null = unlimited.
  maxRedemptions      Int?      @map("max_redemptions")
  /// Uses per person (agent for plans, customer for bookings).
  perUserLimit        Int       @default(1) @map("per_user_limit")
  active              Boolean   @default(true)
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?                @relation("DiscountCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  ownerAgent  AgentProfile?        @relation("DiscountCodeOwner", fields: [ownerAgentProfileId], references: [id], onDelete: Restrict)
  redemptions DiscountRedemption[]

  @@unique([ownerKey, code])
  @@index([scope, active])
  @@index([ownerAgentProfileId])
  @@map("discount_codes")
}

/// One use of a code, for one subscription payment or one booking. PENDING
/// while unpaid (it holds a use), REDEEMED once paid, RELEASED when the
/// payment failed or the booking expired or was cancelled.
model DiscountRedemption {
  id                    String   @id @default(uuid(7)) @db.Uuid
  discountCodeId        String   @map("discount_code_id") @db.Uuid
  /// Who used it: the agent (plans) or the customer (bookings).
  userId                String   @map("user_id") @db.Uuid
  subscriptionPaymentId String?  @unique @map("subscription_payment_id") @db.Uuid
  bookingId             String?  @unique @map("booking_id") @db.Uuid
  amountOffKobo         BigInt   @map("amount_off_kobo")
  status                String   @db.VarChar(20)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  discountCode        DiscountCode         @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptionPayment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Restrict)
  booking             Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([discountCodeId, status])
  @@index([userId, discountCodeId])
  @@map("discount_redemptions")
}

// ── Pop-ups ─────────────────────────────────────────────────────────────────

/// A modal shown on the public site: an announcement, what's new, an offer or
/// a featured property. One is shown per page view (highest priority first),
/// to its audience, on its pages, within its window, as often as `frequency`.
model Popup {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// For administrators only.
  name         String    @db.VarChar(120)
  /// ANNOUNCEMENT | WHATS_NEW | OFFER | PROPERTY
  kind         String    @db.VarChar(20)
  title        String    @db.VarChar(120)
  /// Plain text; line breaks are kept.
  body         String?   @db.VarChar(600)
  imageId      String?   @map("image_id") @db.Uuid
  /// PROPERTY pop-ups: the listing shown (only while it is publicly visible).
  propertyId   String?   @map("property_id") @db.Uuid
  /// Shown with a copy button (display only; checkout validates codes).
  discountCode String?   @map("discount_code") @db.VarChar(32)
  ctaLabel     String?   @map("cta_label") @db.VarChar(40)
  /// A path on this site ("/…").
  ctaLink      String?   @map("cta_link") @db.VarChar(500)
  /// ALL | GUESTS | CUSTOMERS | AGENTS
  audience     String    @default("ALL") @db.VarChar(20)
  /// Path prefixes it appears on ("/" = homepage only); empty = all public pages.
  paths        String[]  @default([])
  /// ONCE | DAILY | EVERY_VISIT
  frequency    String    @default("ONCE") @db.VarChar(20)
  delaySeconds Int       @default(2) @map("delay_seconds")
  priority     Int       @default(0)
  active       Boolean   @default(false)
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(3)
  views        Int       @default(0)
  clicks       Int       @default(0)
  dismissals   Int       @default(0)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  image     CmsMedia? @relation(fields: [imageId], references: [id], onDelete: Restrict)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("PopupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active, priority(sort: Desc)])
  @@map("popups")
}

// ── Reviews & badges ────────────────────────────────────────────────────────

/// A customer's rating of a property after a completed stay: one per booking.
/// Published at once; administrators can hide it (it then stops counting).
model Review {
  id           String    @id @default(uuid(7)) @db.Uuid
  bookingId    String    @unique @map("booking_id") @db.Uuid
  propertyId   String    @map("property_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  rating       Int       @db.SmallInt
  comment      String?   @db.VarChar(2000)
  /// PUBLISHED | HIDDEN
  status       String    @default("PUBLISHED") @db.VarChar(20)
  hiddenReason String?   @map("hidden_reason") @db.VarChar(500)
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  customer User     @relation("ReviewAuthor", fields: [customerId], references: [id], onDelete: Restrict)
  hiddenBy User?    @relation("ReviewModerator", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([propertyId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("reviews")
}

/// A badge administrators design (name + image). MANUAL badges are given to
/// chosen properties; AUTOMATIC ones go to every property meeting the rules.
model Badge {
  id                   String   @id @default(uuid(7)) @db.Uuid
  name                 String   @db.VarChar(60)
  description          String?  @db.VarChar(200)
  imageId              String   @map("image_id") @db.Uuid
  /// MANUAL | AUTOMATIC
  mode                 String   @db.VarChar(20)
  /// AUTOMATIC rules (all that are set must hold).
  minRating            Decimal? @map("min_rating") @db.Decimal(2, 1)
  minReviews           Int?     @map("min_reviews")
  minCompletedBookings Int?     @map("min_completed_bookings")
  active               Boolean  @default(true)
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  image  CmsMedia     @relation(fields: [imageId], references: [id], onDelete: Restrict)
  awards BadgeAward[]

  @@map("badges")
}

/// A badge a property holds now: given by hand (MANUAL) or earned (AUTOMATIC,
/// recalculated when reviews, completed bookings or the badge's rules change).
model BadgeAward {
  badgeId      String   @map("badge_id") @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  /// MANUAL | AUTOMATIC
  source       String   @db.VarChar(20)
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("BadgeAwardAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([badgeId, propertyId])
  @@index([propertyId])
  @@map("badge_awards")
}

// ── Property sales ──────────────────────────────────────────────────────────

/// A buyer accepted the "dealing outside HavenHub" notice before seeing an
/// agent's direct contact details. The exact wording is kept as evidence.
/// No longer written (the notice is now shown alongside the details); kept
/// append-only for the acceptances already recorded.
model SaleContactAcceptance {
  id             String   @id @default(uuid(7)) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  disclaimerText String   @map("disclaimer_text") @db.VarChar(5000)
  /// SHA-256 of the wording, to group acceptances of the same version.
  disclaimerHash String   @map("disclaimer_hash") @db.Char(64)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([propertyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("sale_contact_acceptances")
}

/// Questions asked of the "Ask HavenHub" assistant, so support staff can see
/// what it could not answer (and add FAQs). Kept 180 days.
model AssistantQuestion {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null for signed-out visitors.
  userId    String?  @map("user_id") @db.Uuid
  text      String   @db.VarChar(500)
  intent    String   @db.VarChar(30)
  answered  Boolean
  handedOff Boolean  @default(false) @map("handed_off")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([answered, createdAt(sort: Desc)])
  @@map("assistant_questions")
}
